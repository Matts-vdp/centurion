{
  "name": "centurion",
  "version": "1.0.0",
  "description": "Local manager for orchestrator and expert Claude agents across repositories",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "centurion": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "guide",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matts-vdp/centurion.git"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "concurrently -k -n manager,ui -c blue,magenta \"tsx watch src/cli.ts\" \"vite --config ui/vite.config.ts\"",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "check:docs": "tsx src/check-docs.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "highlight.js": "^11.11.2",
    "lucide-react": "^1.70.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
